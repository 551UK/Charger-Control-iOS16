#!/bin/sh
set +e
case "$1" in
 remove|purge)
  # A genuine uninstall discards the saved preference. Upgrades retain it.
  rm -f /var/jb/var/lib/551uk-usbcurrent/requested-cap.json >/dev/null 2>&1 || true
  [ ! -L /var/jb/usr/libexec/551uk-usbcontroller-python ] && rm -f /var/jb/usr/libexec/551uk-usbcontroller-python
  clips=/var/mobile/Library/WebClips/551UKUSBChargeControl.webclip
  if [ -d "$clips" ] && [ ! -L "$clips" ]; then
    rm -f "$clips/icon.png" "$clips/Info.plist" >/dev/null 2>&1
    rmdir "$clips" >/dev/null 2>&1 || true
  fi
  root=/var/jb/var/mobile/551UK-ChargeRateTest-v052
  rm -f "$root/chargerated.sock" "$root/charging-test.lock" "$root/usbcurrent-watchdog.json" >/dev/null 2>&1
  if [ "$1" = purge ]; then
   # Root-owned state is not deleted on failed restoration: it must remain
   # available to identify/repair any cap after manual jailbreak recovery.
   if [ ! -e /var/jb/var/lib/551uk-usbcurrent/active.json ]; then
     rm -rf /var/jb/var/lib/551uk-usbcurrent >/dev/null 2>&1 || true
   fi
   rm -f "$root/charging-test.txt" "$root/daemon-status.txt" "$root/launchd-install.txt" "$root/usb-controller-install.txt" >/dev/null 2>&1
   rmdir "$root" >/dev/null 2>&1 || true
  fi
  ;;
esac
exit 0
