#!/bin/sh
set +e
case "$1" in
 remove|deconfigure|upgrade)
  export PATH=/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:$PATH
  # Best effort restore with daemon still alive. Never remove a persistent
  # current cap before first asking the privileged daemon to clear it.
  if [ -x /var/jb/usr/bin/python3 ]; then
    /var/jb/usr/bin/python3 -c 'import socket; s=socket.socket(socket.AF_UNIX); s.settimeout(7); s.connect("/var/jb/var/mobile/551UK-ChargeRateTest-v052/chargerated.sock"); s.sendall(b"RESTORE\n"); print(s.recv(64))' >/dev/null 2>&1 || true
  fi
  /var/jb/usr/libexec/551uk-charge-rate-worker --restore >/dev/null 2>&1 || true
  if [ -x /var/jb/usr/bin/launchctl ]; then
    /var/jb/usr/bin/launchctl bootout system/uk.551.chargerated >/dev/null 2>&1 || true
  fi
  ;;
esac
exit 0
