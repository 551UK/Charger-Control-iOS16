#!/bin/sh
set +e
case "$1" in
 install|upgrade)
  export PATH=/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:$PATH
  legacy=/var/jb/Applications/ChargingRate.app
  # Unregister legacy icon before dpkg removes this app during upgrade.
  if [ -d "$legacy" ] && [ ! -L "$legacy" ] && command -v uicache >/dev/null 2>&1; then
    uicache -u "$legacy" >/dev/null 2>&1 || true
  fi
  ;;
esac
exit 0
